.env
node_modules/
artifacts/
cache/
typechain-types/
.next/
out/
deployments/*.local.json
*.log

# Content-addressed caches. Reproducible from the chain plus the engine, so
# committing them would only add noise.
storage/
genomes/

# Netlify CLI local state. Site id only, but tooling state does not belong in the repo.
.netlify/

# Audit logs and the local storage cache written by the CLI and SDK.
.germline/*
!.germline/config.json
