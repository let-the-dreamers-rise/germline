# Never commit the real .env. The deployer key is the only secret here.
DEPLOYER_KEY=0xyour_private_key_here

# Optional overrides; sensible defaults are in hardhat.config.js
ZEROG_RPC=https://evmrpc.0g.ai
GALILEO_RPC=https://evmrpc-testnet.0g.ai

# 0G Storage indexer, used by the engine to publish genomes and transcripts
ZEROG_INDEXER=https://indexer-storage-turbo.0g.ai

# 0G Compute endpoint for the LLM mutation operator (optional)
ZEROG_COMPUTE_URL=
ZEROG_COMPUTE_KEY=
