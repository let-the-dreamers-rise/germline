{
  "name": "germline",
  "version": "0.2.0",
  "description": "A provenance layer for configuration search. Declare what can vary and how you measure better; get back an improvement with a lineage anyone can verify.",
  "license": "MIT",
  "main": "sdk/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "configuration",
    "optimisation",
    "evaluation",
    "provenance",
    "llm",
    "0g"
  ],
  "files": [
    "sdk/",
    "engine/",
    "lib/",
    "contracts/",
    "README.md",
    "docs/"
  ],
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "bench": "node scripts/benchmark.js",
    "example:rag": "node examples/prompt-config.js",
    "example:pricing": "node examples/pricing-rules.js",
    "example:judge": "node examples/llm-judge.js",
    "check:storage": "node scripts/storage-check.js",
    "check:compute": "node scripts/compute-check.js",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network zerog",
    "deploy:testnet": "hardhat run scripts/deploy.js --network galileo",
    "demo": "node scripts/demo.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.10",
    "dotenv": "^16.4.5"
  },
  "dependencies": {
    "@openzeppelin/contracts": "4.9.6"
  }
}
