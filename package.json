{
  "name": "germline",
  "version": "0.4.0",
  "description": "A tamper-evident audit trail for AI configuration changes, anchored on 0G. Record who changed which prompt, model or parameter, why, and the eval that justified it; hand an auditor a record they can verify themselves.",
  "license": "MIT",
  "main": "sdk/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "audit-trail",
    "ai-governance",
    "eu-ai-act",
    "soc2",
    "change-management",
    "provenance",
    "ai-agents",
    "timelock",
    "llm",
    "evaluation",
    "configuration",
    "0g"
  ],
  "files": [
    "bin/",
    "sdk/",
    "engine/",
    "lib/",
    "contracts/",
    "README.md",
    "LICENSE",
    "docs/",
    "SECURITY.md",
    "action.yml"
  ],
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "test:sdk": "mocha test/audit.test.js test/storage.test.js test/track.test.js test/hardening.test.js",
    "bench": "node scripts/benchmark.js",
    "example:rag": "node examples/prompt-config.js",
    "example:pricing": "node examples/pricing-rules.js",
    "example:judge": "node examples/llm-judge.js",
    "check:storage": "node scripts/storage-check.js",
    "check:compute": "node scripts/compute-check.js",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network zerog",
    "deploy:testnet": "hardhat run scripts/deploy.js --network galileo",
    "deploy:anchor": "hardhat run scripts/deploy-anchor.js --network zerog",
    "demo": "node scripts/demo.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.10",
    "dotenv": "^16.4.5"
  },
  "dependencies": {
    "@openzeppelin/contracts": "4.9.6",
    "ethers": "^6.13.1"
  },
  "bin": {
    "germline": "bin/germline.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/let-the-dreamers-rise/germline.git"
  },
  "homepage": "https://github.com/let-the-dreamers-rise/germline#readme",
  "bugs": {
    "url": "https://github.com/let-the-dreamers-rise/germline/issues"
  },
  "peerDependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "^1.2.13"
  },
  "peerDependenciesMeta": {
    "@0gfoundation/0g-storage-ts-sdk": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
